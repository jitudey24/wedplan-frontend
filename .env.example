# Copy to .env.local and fill in your own values.
# Server-only secrets (STRIPE_SECRET_KEY, Mongo credentials) belong in ../WedPlan_Server/.env — never here.

# Backend base URL (default when unset: http://localhost:5000; set BOTH to the same value)
# Production: .env.local is gitignored and never reaches Vercel — set these in
# Vercel Project Settings → Environment Variables (Production + Preview) instead.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_BASE_URL=
# Free key from api.imgbb.com — image uploads (empty → friendly error toast)
NEXT_PUBLIC_IMGBB_API_KEY=
# Stripe publishable key (pk_...) for the in-app /payment page
# (payment/page.tsx also falls back to NEXT_PUBLIC_STRIPE_KEY — same value; not required if this is set)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
